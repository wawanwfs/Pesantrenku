APP_NAME=Pesantenku
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://pesantrenku.ai
PRIMARY_DOMAIN=pesantrenku.ai
ACME_EMAIL=admin@pesantrenku.ai
PESANTRENKU_IMAGE=registry.example.id/pesantenku:latest

LOG_CHANNEL=structured
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=pesantenku
DB_USERNAME=pesantenku
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
GF_SECURITY_ADMIN_PASSWORD=
GF_SERVER_DOMAIN=monitor.pesantrenku.ai
GF_SERVER_ROOT_URL=https://monitor.pesantrenku.ai

CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=.pesantrenku.ai
SESSION_SAME_SITE=lax
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=reverb
REDIS_HOST=redis
REDIS_PORT=6379

FILESYSTEM_DISK=s3
PESANTRENKU_OPERATION_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

REVERB_APP_ID=pesantenku
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=ws.pesantrenku.ai
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_ALLOWED_ORIGINS=pesantrenku.ai,www.pesantrenku.ai,api.pesantrenku.ai
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_SCALING_ENABLED=true
REVERB_SCALING_CHANNEL=pesantenku-reverb

PESANTRENKU_SECURITY_HEADERS=true
PESANTRENKU_NOTIFICATION_SSE=false
PESANTRENKU_NOTIFICATION_WEBSOCKET=true
PESANTRENKU_WEBSOCKET_ORIGIN=wss://ws.pesantrenku.ai
PESANTRENKU_NOTIFICATION_POLL_SECONDS=30
PESANTRENKU_IMPORT_PREVIEW_ROWS=5
PESANTRENKU_IMPORT_QUEUE_THRESHOLD=500
PESANTRENKU_IMPORT_CHUNK_SIZE=250
PESANTRENKU_EXPORT_SYNC_LIMIT=1000
PESANTRENKU_EXPORT_QUEUED_LIMIT=10000
PESANTRENKU_FILE_RETENTION_DAYS=7
PESANTRENKU_SIGNED_URL_MINUTES=10
PESANTRENKU_METRICS_TOKEN=
PESANTRENKU_OTEL_ENABLED=true
PESANTRENKU_REQUIRE_IDEMPOTENCY_KEY=true
PESANTRENKU_DR_MAX_BACKUP_AGE_HOURS=24
PESANTRENKU_DR_REQUIRE_PITR=true
PESANTRENKU_BACKUP_KEY_PROVIDER=kms
PESANTRENKU_RESTORE_REQUIRED_APPROVALS=2
PESANTRENKU_RESTORE_REQUEST_TTL_MINUTES=60
AWS_KMS_BACKUP_KEY_ID=
AWS_KMS_ENDPOINT=

VITE_APP_NAME=Pesantenku
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

OTEL_PHP_AUTOLOAD_ENABLED=true
OTEL_PHP_EXPERIMENTAL_AUTO_ROOT_SPAN=false
OTEL_SERVICE_NAME=pesantenku
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=production,service.namespace=pesantenku
OTEL_TRACES_EXPORTER=otlp
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_PROPAGATORS=tracecontext,baggage
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1
OTEL_PHP_TRACES_PROCESSOR=batch
OTEL_BSP_SCHEDULE_DELAY=200
OTEL_BSP_EXPORT_TIMEOUT=1000
OTEL_BSP_MAX_QUEUE_SIZE=2048
OTEL_BSP_MAX_EXPORT_BATCH_SIZE=512
