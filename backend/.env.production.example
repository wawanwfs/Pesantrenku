APP_NAME=Pesantenku
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://pesantrenku.ai
# Optional one-time bootstrap. Values are host paths to secret-manager files,
# never the password or TOTP secret itself. Remove after first successful run.
PESANTRENKU_BOOTSTRAP_ADMIN_EMAIL=
PESANTRENKU_BOOTSTRAP_PASSWORD_FILE=
PESANTRENKU_BOOTSTRAP_MFA_SECRET_FILE=
PESANTRENKU_BOOTSTRAP_LOCK_SECONDS=180
PESANTRENKU_MFA_PRIVILEGED_ROLES=super_admin,owner_pesantren
TRUSTED_PROXIES=172.16.0.0/12
PESANTRENKU_ENFORCE_ALLOWED_HOSTS=true
PESANTRENKU_ALLOWED_HOSTS=pesantrenku.ai,api.pesantrenku.ai,app
PRIMARY_DOMAIN=pesantrenku.ai
ACME_EMAIL=admin@pesantrenku.ai
PESANTRENKU_IMAGE=registry.example.id/pesantenku@sha256:REPLACE_WITH_64_HEX_DIGEST
# Exact keyless signing identity for the release that produced PESANTRENKU_IMAGE.
# Example: https://github.com/owner/repository/.github/workflows/release.yml@refs/tags/v1.2.3
PESANTRENKU_COSIGN_CERTIFICATE_IDENTITY=
PESANTRENKU_COSIGN_CERTIFICATE_OIDC_ISSUER=https://token.actions.githubusercontent.com

LOG_CHANNEL=structured
LOG_LEVEL=info

MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.example.id
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@pesantrenku.ai
MAIL_FROM_NAME="${APP_NAME}"

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=pesantenku
DB_USERNAME=pesantenku
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
GF_SECURITY_ADMIN_PASSWORD=
GF_SERVER_DOMAIN=monitor.pesantrenku.ai
GF_SERVER_ROOT_URL=https://monitor.pesantrenku.ai

CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=.pesantrenku.ai
SESSION_SAME_SITE=lax
QUEUE_CONNECTION=redis
REDIS_QUEUE_RETRY_AFTER=180
REDIS_LONG_QUEUE_RETRY_AFTER=960
BROADCAST_CONNECTION=reverb
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379

FILESYSTEM_DISK=s3
PESANTRENKU_OPERATION_DISK=s3
PESANTRENKU_OPERATION_PROCESSING_TIMEOUT_MINUTES=20
PESANTRENKU_OPERATION_QUEUE_WAIT_TIMEOUT_MINUTES=60
PESANTRENKU_OPERATION_MAX_RECOVERY_ATTEMPTS=3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

REVERB_APP_ID=pesantenku
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=ws.pesantrenku.ai
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_ALLOWED_ORIGINS=pesantrenku.ai,www.pesantrenku.ai,api.pesantrenku.ai
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_SCALING_ENABLED=true
REVERB_SCALING_CHANNEL=pesantenku-reverb

PESANTRENKU_SECURITY_HEADERS=true
PESANTRENKU_NOTIFICATION_SSE=false
PESANTRENKU_NOTIFICATION_WEBSOCKET=true
PESANTRENKU_WEBSOCKET_ORIGIN=wss://ws.pesantrenku.ai
PESANTRENKU_NOTIFICATION_POLL_SECONDS=30
PESANTRENKU_IMPORT_PREVIEW_ROWS=5
PESANTRENKU_IMPORT_QUEUE_THRESHOLD=500
PESANTRENKU_IMPORT_CHUNK_SIZE=250
PESANTRENKU_IMPORT_MAX_KB=10240
PESANTRENKU_IMPORT_MAX_ROWS=10000
PESANTRENKU_IMPORT_MAX_COLUMNS=100
PESANTRENKU_IMPORT_MAX_UNCOMPRESSED_BYTES=52428800
PESANTRENKU_EXPORT_SYNC_LIMIT=1000
PESANTRENKU_EXPORT_QUEUED_LIMIT=10000
PESANTRENKU_FILE_RETENTION_DAYS=7
PESANTRENKU_TENANT_BACKUP_MAX_ROWS=25000
PESANTRENKU_TENANT_BACKUP_MAX_BYTES=52428800
PESANTRENKU_BACKUP_CREATION_TIMEOUT_MINUTES=20
PESANTRENKU_BACKUP_QUEUE_WAIT_TIMEOUT_MINUTES=60
PESANTRENKU_RESTORE_EXECUTION_TIMEOUT_MINUTES=30
PESANTRENKU_SIGNED_URL_MINUTES=10
PESANTRENKU_METRICS_TOKEN=
PESANTRENKU_ENFORCE_PRIVILEGED_MFA=true
PESANTRENKU_OTEL_ENABLED=true
PESANTRENKU_REQUIRE_IDEMPOTENCY_KEY=true
PESANTRENKU_IDEMPOTENCY_PROCESSING_TTL_MINUTES=30
PESANTRENKU_IDEMPOTENCY_COMPLETED_TTL_HOURS=24
PESANTRENKU_DR_MAX_BACKUP_AGE_HOURS=24
PESANTRENKU_DR_REQUIRE_PITR=true
PESANTRENKU_BACKUP_KEY_PROVIDER=kms
PESANTRENKU_RESTORE_REQUIRED_APPROVALS=2
PESANTRENKU_RESTORE_REQUEST_TTL_MINUTES=60
AWS_KMS_BACKUP_KEY_ID=
AWS_KMS_ENDPOINT=

VITE_APP_NAME=Pesantenku
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

OTEL_PHP_AUTOLOAD_ENABLED=true
OTEL_PHP_EXPERIMENTAL_AUTO_ROOT_SPAN=false
OTEL_SERVICE_NAME=pesantenku
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=production,service.namespace=pesantenku
OTEL_TRACES_EXPORTER=otlp
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_PROPAGATORS=tracecontext,baggage
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1
OTEL_PHP_TRACES_PROCESSOR=batch
OTEL_BSP_SCHEDULE_DELAY=200
OTEL_BSP_EXPORT_TIMEOUT=1000
OTEL_BSP_MAX_QUEUE_SIZE=2048
OTEL_BSP_MAX_EXPORT_BATCH_SIZE=512

PESANTRENKU_BACKUP_ROTATION_LOCK_SECONDS=1800

# Registered mobile scanners are accepted only from these campus/private CIDRs.
PESANTRENKU_QR_CHALLENGE_SECONDS=30
PESANTRENKU_QR_ALLOWED_NETWORKS=10.20.0.0/16,192.168.50.0/24

PESANTRENKU_METRIC_RETENTION_DAYS=14
PESANTRENKU_METRIC_EXPORTER_LEASE_SECONDS=45
METRICS_TRACK=stable
METRICS_REVISION=

PESANTRENKU_ALERTMANAGER_URL=http://alertmanager:9093/-/ready
PESANTRENKU_ALERTMANAGER_API_URL=http://alertmanager:9093/api/v2/alerts
PESANTRENKU_LOKI_URL=http://loki:3100/ready
PESANTRENKU_LOKI_QUERY_URL=http://loki:3100/loki/api/v1/query_range
PESANTRENKU_OPERATIONAL_DRILL_MAIL_TO=
PESANTRENKU_OPERATIONAL_DRILL_CONFIRM_URL=
PESANTRENKU_OPERATIONAL_DRILL_CONFIRM_TOKEN=
PESANTRENKU_OPERATIONAL_DRILL_TIMEOUT_SECONDS=90
PESANTRENKU_BACKUP_READINESS_MAX_AGE_HOURS=24
CADDY_IMAGE=caddy@sha256:REPLACE_WITH_REVIEWED_DIGEST
MYSQL_IMAGE=mysql@sha256:REPLACE_WITH_REVIEWED_DIGEST
REDIS_IMAGE=redis@sha256:REPLACE_WITH_REVIEWED_DIGEST
OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib@sha256:REPLACE_WITH_REVIEWED_DIGEST
TEMPO_IMAGE=grafana/tempo@sha256:REPLACE_WITH_REVIEWED_DIGEST
PROMETHEUS_IMAGE=prom/prometheus@sha256:REPLACE_WITH_REVIEWED_DIGEST
ALERTMANAGER_IMAGE=prom/alertmanager@sha256:REPLACE_WITH_REVIEWED_DIGEST
LOKI_IMAGE=grafana/loki@sha256:REPLACE_WITH_REVIEWED_DIGEST
PROMTAIL_IMAGE=grafana/promtail@sha256:REPLACE_WITH_REVIEWED_DIGEST
GRAFANA_IMAGE=grafana/grafana@sha256:REPLACE_WITH_REVIEWED_DIGEST
MYSQL_TEST_IMAGE=mysql@sha256:REPLACE_WITH_REVIEWED_DIGEST
MYSQL_RECOVERY_IMAGE=mysql@sha256:REPLACE_WITH_REVIEWED_DIGEST
MINIO_IMAGE=minio/minio@sha256:REPLACE_WITH_REVIEWED_DIGEST
MINIO_MC_IMAGE=minio/mc@sha256:REPLACE_WITH_REVIEWED_DIGEST
MYSQL_BINLOG_IMAGE=mysql@sha256:REPLACE_WITH_REVIEWED_DIGEST
ALERTMANAGER_WEBHOOK_URL=https://alerts.example.invalid/pesantenku
