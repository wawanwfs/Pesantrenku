APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
PESANTRENKU_OPERATION_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

PESANTRENKU_SECURITY_HEADERS=true
PESANTRENKU_NOTIFICATION_SSE=true
PESANTRENKU_NOTIFICATION_POLL_SECONDS=20
PESANTRENKU_IMPORT_PREVIEW_ROWS=5
PESANTRENKU_IMPORT_QUEUE_THRESHOLD=500
PESANTRENKU_IMPORT_CHUNK_SIZE=250
PESANTRENKU_EXPORT_SYNC_LIMIT=1000
PESANTRENKU_EXPORT_QUEUED_LIMIT=10000
PESANTRENKU_FILE_RETENTION_DAYS=7
PESANTRENKU_NOTIFICATION_WEBSOCKET=false
PESANTRENKU_WEBSOCKET_ORIGIN=ws://127.0.0.1:8080
PESANTRENKU_SIGNED_URL_MINUTES=10
PESANTRENKU_METRICS_TOKEN=
PESANTRENKU_OTEL_ENABLED=false
PESANTRENKU_REQUIRE_IDEMPOTENCY_KEY=false
PESANTRENKU_DR_MAX_BACKUP_AGE_HOURS=24
PESANTRENKU_DR_REQUIRE_PITR=false
PESANTRENKU_BACKUP_KEY_PROVIDER=local
PESANTRENKU_RESTORE_REQUIRED_APPROVALS=2
PESANTRENKU_RESTORE_REQUEST_TTL_MINUTES=60
AWS_KMS_BACKUP_KEY_ID=
AWS_KMS_ENDPOINT=

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_ALLOWED_ORIGINS=localhost,127.0.0.1
REVERB_SCALING_ENABLED=false
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

OTEL_PHP_AUTOLOAD_ENABLED=false
OTEL_PHP_EXPERIMENTAL_AUTO_ROOT_SPAN=false
OTEL_SERVICE_NAME=pesantenku
OTEL_TRACES_EXPORTER=none
OTEL_PROPAGATORS=tracecontext,baggage
OTEL_PHP_TRACES_PROCESSOR=batch
OTEL_BSP_SCHEDULE_DELAY=200
OTEL_BSP_EXPORT_TIMEOUT=1000
OTEL_BSP_MAX_QUEUE_SIZE=2048
OTEL_BSP_MAX_EXPORT_BATCH_SIZE=512
