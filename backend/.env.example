PROMTAIL_IMAGE=grafana/promtail@sha256:REPLACE_WITH_REVIEWED_DIGEST
GRAFANA_IMAGE=grafana/grafana@sha256:REPLACE_WITH_REVIEWED_DIGEST
MYSQL_TEST_IMAGE=mysql@sha256:REPLACE_WITH_REVIEWED_DIGEST
MYSQL_RECOVERY_IMAGE=mysql@sha256:REPLACE_WITH_REVIEWED_DIGEST
